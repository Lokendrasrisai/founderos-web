# ─────────────────────────────────────────────────────────────────────────────
# FounderOS environment variables. Copy to .env.local for local development.
# Never commit real values. All variables are optional.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, e.g. https://example.com (no trailing slash).
# Enables canonical URLs, absolute Open Graph URLs, and a populated sitemap.
# Leave unset until the domain is decided.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery via Resend (https://resend.com). The form appears ONLY when all three are set.
# CONTACT_FROM_EMAIL must be an address on a domain you have verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Preview mode: renders drafts and DEMO_ONLY fixtures with visible badges, noindex everywhere.
# Refused on production deployments (the build fails if VERCEL_ENV=production).
FOUNDEROS_DEMO_CONTENT=

# Testing only: point contact delivery at a mock provider. Ignored when VERCEL_ENV=production.
# RESEND_API_BASE=http://127.0.0.1:4010

# Testing only: use an existing Chromium for Playwright instead of `npx playwright install`.
# PLAYWRIGHT_CHROMIUM_PATH=
